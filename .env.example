# ---- runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- datastores ----
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://pulseq:pulseq@localhost:5432/pulseq?schema=public

# ---- worker ----
# namespaces this worker leases from (comma-separated)
WORKER_NAMESPACES=default
# max jobs in flight per worker at once (the backpressure knob)
WORKER_CONCURRENCY=16
# how many jobs to lease in one XREADGROUP call
WORKER_BATCH_SIZE=8
# visibility timeout: a leased job with no lease renewal for this long is
# reclaimable by another worker
LEASE_TTL_MS=30000
# renew the lease when this fraction of LEASE_TTL_MS has elapsed
LEASE_RENEW_AT=0.5
# poll interval when the ready stream is empty
IDLE_POLL_MS=1000
# how often the delayed -> ready promoter runs
PROMOTE_INTERVAL_MS=1000

# ---- retry / DLQ ----
DEFAULT_MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_CAP_MS=300000
# full | equal | none  (jitter strategy)
BACKOFF_JITTER=equal

# ---- backpressure ----
# producers are told to slow down when ready+delayed depth exceeds this
DEPTH_HIGH_WATERMARK=10000
DEPTH_LOW_WATERMARK=2000

# ---- admin + metrics ----
ADMIN_PORT=7411
METRICS_PORT=9464
